# Copy this file to agent/agent.env:
#   cp agent/agent.env.example agent/agent.env
# agent/agent.env should normally stay untracked.
# Do not put API keys, W&B keys, passwords, or other secrets in this file.

# -----------------------------------------------------------------------------
# Current Phase 1 baseline: skrl MLP-PPO CommandFollow
# -----------------------------------------------------------------------------
TASK="Isaac-TractionProtect-CommandFollow-Car4WD-v0"
EVAL_TASK="Isaac-TractionProtect-CommandFollow-Car4WD-Play-v0"
ALGORITHM="PPO"
ML_FRAMEWORK="torch"

# -----------------------------------------------------------------------------
# Isaac Lab launch paths
# Relative paths are resolved from the Git repository root.
# -----------------------------------------------------------------------------
ISAACLAB_SH="isaaclab.sh"
TRAIN_SCRIPT="scripts/reinforcement_learning/skrl/train.py"
PLAY_SCRIPT="scripts/reinforcement_learning/skrl/play.py"

# -----------------------------------------------------------------------------
# Agent verification defaults
# Override per command when needed, for example:
#   NUM_ENVS=16 MAX_ITERATIONS=5 ./scripts/agent_smoke_test.sh
# -----------------------------------------------------------------------------
SMOKE_NUM_ENVS="4"
SMOKE_MAX_ITERATIONS="2"

SHORT_NUM_ENVS="64"
SHORT_MAX_ITERATIONS="50"

EVAL_NUM_ENVS="1"

# Training is headless by default for autonomous Agent runs.
# Set EVAL_HEADLESS=0 when you want to watch the play task in the Isaac Sim GUI.
TRAIN_HEADLESS="1"
EVAL_HEADLESS="1"

# Optional deterministic seed. Leave empty to use the task/agent default.
SEED=""

# -----------------------------------------------------------------------------
# Wall-clock safety guards
# These are backup guards in addition to --max_iterations.
# Set a value to 0 to disable its wall-clock guard.
# -----------------------------------------------------------------------------
SMOKE_TIMEOUT_SECONDS="240"
SHORT_TIMEOUT_SECONDS="900"
EVAL_TIMEOUT_SECONDS="300"

# -----------------------------------------------------------------------------
# Agent-wrapper logs only
# skrl checkpoints, metrics, and W&B data are written to the external-drive
# directory configured in the task's skrl_ppo_cfg.yaml.
# Relative paths are resolved from the repository root.
# -----------------------------------------------------------------------------
RUN_ROOT="runs/agent"

# General PyTorch CUDA allocator setting. This is not Dreamer-specific.
PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

# Extra CLI / Hydra arguments can be appended directly, for example:
#   ./scripts/agent_train_short.sh --seed 42
#   ./scripts/agent_train_short.sh agent.experiment.write_interval=100
